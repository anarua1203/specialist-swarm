# Copy this to .env and fill in your values.
#
# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Microsoft 365 (calendar agent — M365 account) ────────────────────────────
# App registration in Azure AD with application permission: Calendars.Read
# https://portal.azure.com → App registrations → your app → Certificates & secrets
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret-here
M365_USER_EMAIL=you@capgemini.com

# ── Google Calendar (calendar agent — Google account) ────────────────────────
# Service account with domain-wide delegation, scope: calendar.readonly
# Download the JSON key from GCP Console → IAM → Service accounts
GOOGLE_CREDENTIALS_JSON=/path/to/service-account-key.json
# If using a service account, set the user to impersonate:
GOOGLE_DELEGATED_EMAIL=you@gmail.com
# Calendar to read (defaults to "primary" if not set):
# GOOGLE_CALENDAR_ID=primary
