# Copy to .env and fill in. Nothing here is required for the offline demo.

# Anthropic API key. When unset, Regina runs in mock mode (no API calls).
ANTHROPIC_API_KEY=

# auto | mock | live   (auto = live when a key or `ant auth login` profile exists, else mock)
REGINA_MODE=auto

# Orchestrator model (Messages API) and sub-agent model (when REGINA_SUBAGENTS=llm)
REGINA_MODEL=claude-opus-5
REGINA_SUBAGENT_MODEL=claude-sonnet-5

# mock | llm   How the local sub-agents answer. mock = deterministic over fixtures, llm = a Claude call over the same fixtures.
REGINA_SUBAGENTS=mock

# How Regina addresses you. Team Prompt Queens default below.
REGINA_USER_NAME=Your Majesty

# Pin "today" (YYYY-MM-DD) so fixture dates are reproducible in tests/demos. Empty = real today.
REGINA_TODAY=
